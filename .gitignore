# Rust build artifacts
/target/
Cargo.lock
**/*.rs.bk

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Embedded development
*.elf
*.bin
*.hex
*.map
*.lst

# Debug artifacts
*.d
*.o

# JLink/probe-rs logs
*.log
RTT*.txt

# Local configuration
.cargo/

# ...except board crates, where .cargo/config.toml (target, runner, rustflags)
# is part of the crate and must be committed.
!boards/*/.cargo/
!boards/*/.cargo/config.toml

# Build artifacts inside board crates (the root /target/ rule does not reach
# them, and they are hundreds of MB).
boards/**/target/

# Vendor documentation (schematics/datasheets are large; keep them local).
docs/*.pdf

# Claude Code session files
.claude/

# Documentation build
/doc/

# Coverage reports
*.profraw
*.profdata
/coverage/
